#include "LamaPon/Core/BuildInfo.h"

namespace LamaPon
{
    // BuildInfoを静的なビルド情報で返します。
    const BuildInfo& GetBuildInfo() noexcept
    {
        // configure時のGit情報
        static constexpr BuildInfo info{
            "@LAMAPON_BUILD_BRANCH@",
            "@LAMAPON_BUILD_COMMIT@",
            "@LAMAPON_BUILD_COMMIT_FULL@",
            "@LAMAPON_BUILD_COMMIT_SUBJECT@",
            @LAMAPON_BUILD_DIRTY_CPP@,
        };
        return info;
    }
}
