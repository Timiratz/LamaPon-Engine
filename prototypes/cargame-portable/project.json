{
  "format": "LamaPonWebTarget",
  "projectName": "CarGame",
  "gameName": "MR-S Time Attack",
  "name": "LamaPonCarGamePortable",
  "export": {
    "targets": ["web"],
    "modules": [
      "core",
      "renderer2d",
      "renderer3d",
      "input",
      "physics3d",
      "audio",
      "particles3d"
    ],
    "web": {
      "renderer": "webgl2",
      "buildSystem": "lamapon",
      "portableGame": true,
      "sourceDirectory": "../../../CarGame",
      "sources": [
        "assets/scripts/CameraSystem.cpp",
        "assets/scripts/CarCollisionProbe.cpp",
        "assets/scripts/CarGameWorld.cpp",
        "assets/scripts/CarSystem.cpp",
        "assets/scripts/CarVisual.cpp",
        "assets/scripts/HudSystem.cpp",
        "assets/scripts/SkidMarkSystem.cpp",
        "assets/scripts/SoundSystem.cpp",
        "assets/scripts/TrackSystem.cpp"
      ],
      "cmakeTarget": "LamaPonCarGamePortable",
      "singleFile": true,
      "compatibilityProfile": "webgl2-basic-3d",
      "assetDirectory": "assets",
      "assetIncludePaths": ["audio", "scenes", "textures"],
      "scenePath": "/assets/scenes/Main.scene.json"
    }
  }
}
